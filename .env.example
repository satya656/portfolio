# Copy this to .env and fill in your values

# Required: Anthropic API key for post generation
ANTHROPIC_API_KEY=your_api_key_here

# Dashboard Basic Auth credentials (protects /dashboard.html and all /api/* routes)
DASHBOARD_USER=your_username
DASHBOARD_PASS=your_password

# Optional: override the posts directory path (default: ../posts relative to web/)
# POSTS_DIR=/absolute/path/to/posts
